                <ui:ProgressBar name="builder-bar" high-value="1" class="primary" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-grow: 1; justify-content: center; height: 8px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(224, 222, 244); border-right-color: rgb(224, 222, 244); border-top-color: rgb(224, 222, 244); border-bottom-color: rgb(224, 222, 244);"/>
                <ui:Label text="10" name="builder-label" picking-mode="Ignore" class="stat-progress-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="panel-vehicle" picking-mode="Ignore" style="flex-grow: 1; flex-direction: column;">
