            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                <ui:Label text="\udb80\udf5b" parse-escape-sequences="true" name="cpu-icon" picking-mode="Ignore" class="icon"/>
                <ui:ProgressBar name="cpu-bar" high-value="1" class="primary" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-grow: 1; justify-content: center; height: 8px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(224, 222, 244); border-right-color: rgb(224, 222, 244); border-top-color: rgb(224, 222, 244); border-bottom-color: rgb(224, 222, 244);"/>
