                <ui:Label text="700maaaaaa" name="radar-label" picking-mode="Ignore" class="stat-progress-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="panel-processor" picking-mode="Ignore" style="flex-grow: 1; flex-direction: column;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                <ui:Label text="\uefc5" parse-escape-sequences="true" name="memory-icon" picking-mode="Ignore" class="icon"/>
