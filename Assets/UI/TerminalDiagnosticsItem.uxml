<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="diagnostics-item">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:VisualElement name="diagnostic-icon" style="width: 14px; height: 14px; flex-shrink: 0; flex-grow: 0; flex-basis: 14px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; background-image: url(&quot;project://database/Assets/UI/Icons/Error.png?fileID=2800000&amp;guid=fd88a9ee3ce329be3b568bfc0a5d009c&amp;type=3#Error&quot;);"/>
            <ui:Label text="very long error very long" name="diagnostic-label" selectable="true" focusable="true" style="white-space: normal; font-size: 10px; flex-grow: 1; flex-basis: 100%; flex-shrink: 1; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 4px; margin-left: 4px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="\uf08e" parse-escape-sequences="true" name="diagnostic-location-remote" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/UbuntuNerdFont-Regular.ttf?fileID=12800000&amp;guid=6543d423e60b6f58e8760292a8f19e0e&amp;type=3#UbuntuNerdFont-Regular&quot;); -unity-font-style: bold; font-size: 10px; padding-top: 0; padding-right: 2px; padding-bottom: 0; padding-left: 2px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-center; color: rgb(30, 144, 255); display: none;"/>
            <ui:Button text="\udb82\ude1e" parse-escape-sequences="true" name="diagnostic-button-vscode" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/UbuntuNerdFont-Regular.ttf?fileID=12800000&amp;guid=6543d423e60b6f58e8760292a8f19e0e&amp;type=3#UbuntuNerdFont-Regular&quot;); font-size: 10px; padding-top: 0; padding-right: 2px; padding-bottom: 0; padding-left: 2px; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 2px; display: none;"/>
            <ui:Label text="netcode://0/palsdffasdkfoksdofgksdfgjkdflégjdfégjdfklgjkldfgjldfgjldfgdfg.vi" name="diagnostic-location" selectable="true" focusable="true" style="font-size: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; white-space: normal; color: rgb(136, 136, 136);"/>
