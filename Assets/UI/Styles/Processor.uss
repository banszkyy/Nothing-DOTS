.terminal {
    background-color: #000000;
    flex-shrink: 0;
    flex-grow: 1;
    flex-basis: 100px;
    display: flex;
    border-left-color: #00000000;
    border-right-color: #00000000;
    border-top-color: #00000000;
    border-bottom-color: #00000000;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.terminal:enabled:focus {
    border-left-color: var(--focusedBorder);
    border-right-color: var(--focusedBorder);
    border-top-color: var(--focusedBorder);
    border-bottom-color: var(--focusedBorder);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.diagnostics-item {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    flex-grow: 1;
    background-color: var(--backgroundSecondary);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: #00000000;
    border-right-color: #00000000;
    border-top-color: #00000000;
    border-bottom-color: #00000000;
}

.diagnostics-item > .unity-foldout > Toggle {
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    margin-bottom: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__content {
    margin-left: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    padding-top: 0;
    padding-right: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    -unity-background-image-tint-color: var(--foreground);
    width: 14px;
    height: 14px;
}

.terminal #unity-content-container {
    flex-grow: 1;
}

.unity-fill-tab > #unity-tab__content-container {
    flex-grow: 1;
}

.heap-block {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 12px;
    margin: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.heap-block.heap-block-used {
    border-left-color: #eb6f92;
    border-right-color: #eb6f92;
    border-top-color: #eb6f92;
    border-bottom-color: #eb6f92;
}

.heap-block.heap-block-free {
    border-left-color: #908caa;
    border-right-color: #908caa;
    border-top-color: #908caa;
    border-bottom-color: #908caa;
}

.heap-block Label {
    font-size: 10px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-style: bold;
}

#diagnostic-foldout > #unity-content {
    margin-left: 16px;
}
