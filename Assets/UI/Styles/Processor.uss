.terminal {
    background-color: #000000;
    flex-shrink: 0;
    flex-grow: 1;
    flex-basis: 100px;
    display: flex;
    border-left-color: #00000000;
    border-right-color: #00000000;
    border-top-color: #00000000;
    border-bottom-color: #00000000;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.terminal:enabled:focus {
    border-left-color: var(--focusedBorder);
    border-right-color: var(--focusedBorder);
    border-top-color: var(--focusedBorder);
    border-bottom-color: var(--focusedBorder);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.diagnostics-item {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    flex-grow: 1;
    background-color: var(--backgroundSecondary);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: #00000000;
    border-right-color: #00000000;
    border-top-color: #00000000;
    border-bottom-color: #00000000;
}

.diagnostics-item > .unity-foldout > Toggle {
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    margin-bottom: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__content {
    margin-left: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    padding-top: 0;
    padding-right: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    -unity-background-image-tint-color: var(--foreground);
    width: 14px;
    height: 14px;
}

.terminal #unity-content-container {
    flex-grow: 1;
}

.unity-fill-tab > #unity-tab__content-container {
    flex-grow: 1;
}

.heap-block {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 4px;
    margin: 2px;
    padding: 0px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.heap-block.heap-block-used {
    border-left-color: #b7b3d2;
    border-right-color: #b7b3d2;
    border-top-color: #b7b3d2;
    border-bottom-color: #b7b3d2;
}

.heap-block.heap-block-used Label {
    color: #b7b3d2;

}

.heap-block.heap-block-free {
    border-left-color: #636363;
    border-right-color: #636363;
    border-top-color: #636363;
    border-bottom-color: #636363;
}

.heap-block.heap-block-free Label {
    color: #636363;
}

.heap-block Label {
    font-size: 7px;
    margin-top: 0;
    margin-right: 2px;
    margin-bottom: 0;
    margin-left: 2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-style: bold;
}

#diagnostic-foldout > #unity-content {
    margin-left: 16px;
}
