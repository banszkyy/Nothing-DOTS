.terminal Label {
    background-color: #00000000;
    flex-basis: auto;
    margin: 0px;
    padding: 0px; 
    margin-bottom: -4px;
    font-size: 12px;
    border-radius: 0px;
    border-width: 0px;
    -unity-paragraph-spacing: -24px;
    white-space: normal;
    -unity-text-align: lower-left;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RobotoMono-Medium.ttf?fileID=12800000&guid=571b113ec7a2c61919ddf63237f557d4&type=3#RobotoMono-Medium");
}

.diagnostics-item {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    flex-grow: 1;
    background-color: var(--backgroundSecondary);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: #00000000;
    border-right-color: #00000000;
    border-top-color: #00000000;
    border-bottom-color: #00000000;
}

.diagnostics-item > .unity-foldout > Toggle {
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    margin-bottom: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__content {
    margin-left: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    padding-top: 0;
    padding-right: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.diagnostics-item > .unity-foldout > .unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    -unity-background-image-tint-color: var(--foreground);
    width: 14px;
    height: 14px;
}

.terminal #unity-content-container {
    flex-grow: 1;
}

.unity-fill-tab > #unity-tab__content-container {
    flex-grow: 1;
}

.heap-block {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 4px;
    margin: 2px;
    padding: 0px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.heap-block.heap-block-used {
    background-color: #464646;
    border-left-color: #464646;
    border-right-color: #464646;
    border-top-color: #464646;
    border-bottom-color: #464646;
}

.heap-block.heap-block-used Label {
    color: #cbcbcb;

}

.heap-block.heap-block-free {
    border-left-color: #636363;
    border-right-color: #636363;
    border-top-color: #636363;
    border-bottom-color: #636363;
}

.heap-block.heap-block-free Label {
    color: #636363;
}

.heap-block Label {
    font-size: 7px;
    margin-top: 0;
    margin-right: 2px;
    margin-bottom: 0;
    margin-left: 2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-style: bold;
}

#diagnostic-foldout > #unity-content {
    margin-left: 16px;
}
