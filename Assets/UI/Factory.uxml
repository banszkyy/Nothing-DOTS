<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="Factory Queue Item" src="project://database/Assets/UI/UnitItem.uxml?fileID=9197481963319205126&amp;guid=0034aa35a18d2f9e686a4ade6d65ef21&amp;type=3#FactoryAvaliableItem"/>
    <ui:Template name="Terminal" src="project://database/Assets/UI/Processor.uxml?fileID=9197481963319205126&amp;guid=b7b1b5db4ce3d99cc983100f7025c813&amp;type=3#Processor"/>
    <Style src="project://database/Assets/UI/Styles/Style.uss?fileID=7433441132597879392&amp;guid=c2d58f7c49026b5c192353093602f48b&amp;type=3#Style"/>
    <ui:VisualElement picking-mode="Ignore" name="factory-menu-container" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; justify-content: center; align-items: center;">
        <ui:GroupBox text="Factory" class="panel" style="min-height: 200px; min-width: 231px; width: 70%; height: 70%;">
            <ui:TabView tabindex="-1" style="flex-grow: 1;">
                <ui:Tab label="Production" style="flex-grow: 1;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
                        <ui:VisualElement>
                            <ui:ProgressBar name="current-progressbar" high-value="1" low-value="0" style="margin-bottom: 0; margin-top: 0;"/>
                            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                <ui:VisualElement name="current-container" style="background-color: rgb(0, 52, 137);">
                                    <ui:Instance template="Factory Queue Item"/>
                                </ui:VisualElement>
                                <ui:ScrollView name="queue-scrollview" mode="Horizontal" style="flex-direction: row;">
                                    <ui:Instance template="Factory Queue Item"/>
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="\ueaf4" parse-escape-sequences="true" style="margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; padding-right: 0; padding-left: 0; margin-right: 0; margin-left: 0; -unity-text-align: middle-center; font-size: 12px; -unity-font-style: bold;"/>
                            <ui:ScrollView horizontal-scroller-visibility="Hidden" name="available-scrollview" style="flex-grow: 1;">
                                <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-wrap: wrap;">
                                    <ui:Instance template="Factory Queue Item"/>
                                    <ui:Instance template="Factory Queue Item"/>
                                </ui:VisualElement>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Tab>
                <ui:Tab label="Processor" style="flex-grow: 1;">
                    <ui:Instance template="Terminal"/>
                </ui:Tab>
            </ui:TabView>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
