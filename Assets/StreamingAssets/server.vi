using "lib/api";
using "netstack";

struct Client {
    i32 id;
    i32 address;
    float3 lastDirection;
}

List<Client> clients = new List<Client>();

bool clientByAddress(List<Client>& clients, i32 address, Client* result) {
    for (int i = 0; i < clients.length(); i++) {
        if (clients[i].address == address) {
            if (result) *result = clients[i];
            return true;
        }
    }
    return false;
}

bool clientById(List<Client>& clients, i32 id, Client* result) {
    for (int i = 0; i < clients.length(); i++) {
        if (clients[i].id == id) {
            if (result) *result = clients[i];
            return true;
        }
    }
    return false;
}

while (true) {
    LEDs.custom_led = true;

    while (true) {
        byte[30] buffer;
        float3 direction;
        int l = wreceive(&buffer, &direction, (byte*)0);
        if (!l) break;
        int o = 0;

        if (buffer[o] == (byte)RadioHeaderValues.Uplink) {
            RadioHeader* rh = &buffer[o] as RadioHeader*;
            o += sizeof(RadioHeader);

            if (buffer[o] == (byte)Header.DhcpRequest) {
                DhcpRequest* req = &buffer[o] as DhcpRequest*;
                Client already;
                if (clientById(clients, req.id, &already)) {
                    printf("Address %d already assigned to %d\n", already.address, req.id);
                    ldebug(direction * new float3(1f, 0f, 1f) * 3, Color.Cyan);

                    u8[] res = pack {
                        new RadioHeader {
                            header = RadioHeaderValues.Downlink,
                        },
                        new DhcpResponseOk {
                            header = Header.DhcpResponseOk,
                            id = req.id,
                            address = already.address,
                        },
                    };
                    wsend(&res, res.Length, direction, 8);
                } else {
                    bool ok = false;
                    for (i32 i = 1; i < 621; i++) {
                        if (!clientByAddress(clients, i, 0 as Client*)) {
                            Client newClient;
                            newClient.id = req.id;
                            newClient.address = i;
                            newClient.lastDirection = direction;
                            clients.add(newClient);

                            printf("Address %d assigned to %d\n", i, req.id);

                            u8[] res = pack {
                                new RadioHeader {
                                    header = RadioHeaderValues.Downlink,
                                },
                                new DhcpResponseOk {
                                    header = Header.DhcpResponseOk,
                                    id = req.id,
                                    address = i,
                                },
                            };
                            wsend(&res, res.Length, direction, 8);
                            ok = true;
                            break;
                        }
                    }
                    if (!ok) printf("Failed to assign address to %d\n", req.id);
                }
            } else if (buffer[o] == (byte)Header.AuthChallenge) {
                AuthChallenge* req = &buffer[o] as AuthChallenge*;
                if (distancesqr(req.position, GPS.position) < 4f * 4f) {
                    u8[] res = pack {
                        new RadioHeader {
                            header = RadioHeaderValues.Downlink,
                        },
                        new AuthResponse {
                            header = Header.AuthResponse,
                            dst = req.src,
                            authNum = req.authNum,
                        },
                    };
                    wsend(&res, res.Length, direction, 8);
                } else {
                    u8[] res = pack {
                        new RadioHeader {
                            header = RadioHeaderValues.Downlink,
                        },
                        *req,
                    };
                    wsend(&res, res.Length, req.position - (GPS.position + new float3(0, 19, 0)), 8);
                }
            } else if (buffer[o] == (byte)Header.Ping) {
                Ping* req = &buffer[o] as Ping*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++)
                {
                    if (clients[i].address == req.dst)
                    {
                        wsend(&res, res.Length, clients[i].lastDirection, 8);
                        break;
                    }
                }
            } else if (buffer[o] == (byte)Header.Pong) {
                Pong* req = &buffer[o] as Pong*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++) {
                    if (clients[i].address == req.dst) {
                        wsend(&res, res.Length, clients[i].lastDirection, 8);
                        break;
                    }
                }
            } else if (buffer[o] == (byte)Header.AuthResponse) {
                AuthResponse* req = &buffer[o] as AuthResponse*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++) {
                    if (clients[i].address == req.dst) {
                        wsend(&res, res.Length, clients[i].lastDirection, 8);
                        break;
                    }
                }
            } else if (buffer[o] == (byte)Header.Radar) {
                Radar* req = &buffer[o] as Radar*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++) {
                    if (clients[i].address == req.dst) {
                        wsend(&res, res.Length, clients[i].lastDirection, 8);
                        break;
                    }
                }
            } else if (buffer[o] == (byte)Header.EnemyAt) {
                EnemyAt* req = &buffer[o] as EnemyAt*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++) {
                    wsend(&res, res.Length, clients[i].lastDirection, 8);
                }
            } else if (buffer[o] == (byte)Header.AllyAt) {
                AllyAt* req = &buffer[o] as AllyAt*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++) {
                    wsend(&res, res.Length, clients[i].lastDirection, 8);
                }
            } else if (buffer[o] == (byte)Header.AuthenticatorAdvertisement) {
                AuthenticatorAdvertisement* req = &buffer[o] as AuthenticatorAdvertisement*;
                u8[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Downlink,
                    },
                    *req,
                };

                for (int i = 0; i < clients.length(); i++) {
                    if (clients[i].address != req.src) {
                        wsend(&res, res.Length, clients[i].lastDirection, 8);
                    }
                }
            }
        }
    }
}
