using "lib/move";
using "lib/api";

[UnitCommand(1, "Extract")]
struct CommandExtract
{
    [Context("position")] float3 position;
}

[UnitCommand(2, "Move to")]
struct CommandMoveTo
{
    [Context("position")] float3 position;
}

const int MaxCommandDataSize = 8;

void Receive()
{
    byte[MaxPacketLength] v;
    float3 direction;

    while (1)
    {
        int receivedLength = wreceive(&v, MaxPacketLength, &direction);
        if (!receivedLength) { break; }

        if (v[0] == (byte)PacketHeader.request &&
            receivedLength == sizeof(VerificationRequestPacket))
        {
            VerificationRequestPacket* packet = &v as VerificationRequestPacket*;

            if (distancesqr(packet.position, GPS.position) < DistanceThresholdSq)
            {
                printline(" M");
                VerificationResponsePacket responsePacket = new VerificationResponsePacket;
                responsePacket.header = PacketHeader.response;
                responsePacket.position = packet.position;
                debug(packet.position, Color.Cyan);
                wsend(&responsePacket as byte[]*, sizeof(VerificationResponsePacket), &direction, 0.1f);
            }
        }
    }
}

float3 currentDestination = new float3;
float3 currentExtract = new float3;

while (1)
{
    Receive();

    byte[MaxCommandDataSize] _command;

    int commandId = dequeue_command(&_command);

    if (commandId == 1)
    {
        CommandExtract* command = &_command as CommandExtract*;
        currentExtract = command.position;
        currentDestination = new float3;
    }
    else if (commandId == 2)
    {
        CommandMoveTo* command = &_command as CommandMoveTo*;
        currentExtract = new float3;
        currentDestination = command.position;
    }

    if (currentDestination.x != 0f &&
        currentDestination.z != 0f)
    {
        move_to(currentDestination.x, currentDestination.z);
    }

    if (currentExtract.x != 0f &&
        currentExtract.z != 0f)
    {
        float d = distancesqr(GPS.position, currentExtract);
        if (d < 2f * 2f)
        {
            stop_moving();
            debug(currentExtract, Color.White);

            CombatTurret.shoot = (byte)1;
        }
        else
        {
            move_to(currentExtract.x, currentExtract.z);
        }
    }
}
