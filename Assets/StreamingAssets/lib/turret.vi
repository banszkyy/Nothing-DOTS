using "api";

const float G = 9.82f;
const float PROJECTILE_V = 40f;
const float PROJECTILE_V2 = PROJECTILE_V * PROJECTILE_V;
const float HEIGHT_OFFSET = 0;

float calculate_angle(float targetDistance)
{
    float a = (G * targetDistance) / PROJECTILE_V2;
    if (a < -1f || a > 1f)
    {
        return -0.785398f;
    }
    else
    {
        return -0.5f * asin(a);
    }
}

float calculate_angle(float targetDistance, float height)
{
    float discriminant = (
        (PROJECTILE_V2 * PROJECTILE_V2) -
        (G * (G * targetDistance * targetDistance + ((HEIGHT_OFFSET + height) * 2f * PROJECTILE_V2)))
    );

    if (discriminant < 0f)
    {
        return -0.785398f;
    }
    else if (1)
    {
        return atan(
            (PROJECTILE_V2 + sqrt(discriminant)) /
            (G * targetDistance)
        ) - (PI * 0.5f);
    }
    else
    {
        return atan(
            (PROJECTILE_V2 - sqrt(discriminant)) /
            (G * targetDistance)
        ) - (PI * 0.5f);
    }
}

byte calculate_angle(float targetDistance, float height, float* angle)
{
    float discriminant = (
        (PROJECTILE_V2 * PROJECTILE_V2) -
        (G * (G * targetDistance * targetDistance + (height * 2f * PROJECTILE_V2)))
    );

    if (discriminant < 0f)
    {
        return (byte)0;
    }
    else if (1)
    {
        *angle = atan(
            (PROJECTILE_V2 + sqrt(discriminant)) /
            (G * targetDistance)
        ) - (PI * 0.5f);
        return (byte)1;
    }
    else
    {
        *angle = atan(
            (PROJECTILE_V2 - sqrt(discriminant)) /
            (G * targetDistance)
        ) - (PI * 0.5f);
        return (byte)1;
    }
}

float calculate_rotation(float2 target)
{
    float2 targetDirection = normalise(target);
    float targetAngle = atan2(targetDirection.y, targetDirection.x);
    if (targetAngle < 0f) { targetAngle += TAU; }
    if (targetAngle >= TAU) { targetAngle -= TAU; }
    return targetAngle;
}

export byte targetat(float2 target, float2* targetedPosition)
{
    if (target.x == 0f &&
        target.y == 0f)
    {
        return (byte)0;
    }

    if (targetedPosition.x != target.x ||
        targetedPosition.y != target.y)
    {
        *targetedPosition = target;
        target.y -= 0.2f;

        CombatTurret.target_rotation = calculate_rotation(target);

        float targetDistance = length(target);
        // targetDistance -= cos(CombatTurret.current_angle) * 2.5f;
        // float height = sin(CombatTurret.current_angle) * 2.5f;

        CombatTurret.target_angle = calculate_angle(targetDistance);
    }

    float diff1 = abs(CombatTurret.current_rotation - CombatTurret.target_rotation);
    float diff2 = abs(CombatTurret.current_angle - CombatTurret.target_angle);

    if ((diff1 < 0.1f || TAU - diff1 < 0.1f) && (diff2 < 0.01f || TAU - diff2 < 0.01f))
    {
        return (byte)1;
    }

    return (byte)0;
}

//const float ProjectileV = 110f;
//const float ProjectileV2 = ProjectileV * ProjectileV;
//const float ProjectileV4 = ProjectileV2 * ProjectileV2;

byte solve_ballistic_arc(float3 selfWorldPosition, float3 targetWorldPosition, float3* shootDirection)
{
    float ProjectileV;
    query_attribute(1, &ProjectileV);
    float ProjectileV2 = ProjectileV * ProjectileV;
    float ProjectileV4 = ProjectileV2 * ProjectileV2;

    float3 diff = targetWorldPosition - selfWorldPosition;
    float groundDistance = sqrt(diff.x * diff.x + diff.z * diff.z);

    float root = ProjectileV4 - G * (G * groundDistance * groundDistance + 2.0 * diff.y * ProjectileV2);

    if (root < 0) return (byte)0;

    root = sqrt(root);
    float gx = G * groundDistance;

    float lowAng = atan2(ProjectileV2 - root, gx);
    //float highAng = atan2(ProjectileV2 + root, gx);

    float3 groundDir = new float3(diff.x, 0f, diff.z) / groundDistance;
    *shootDirection = groundDir * cos(lowAng) + new float3(0.0, 1.0, 0.0) * sin(lowAng);

    return (byte)1;
}

export byte targetat(float3 target, float3* targetedPosition)
{
    if (target.x == 0f &&
        target.z == 0f)
    {
        return (byte)0;
    }

    float3 targetLocal = target;
    tolocal(&targetLocal);

    if (targetedPosition.x != targetLocal.x ||
        targetedPosition.z != targetLocal.z)
    {
        float3 result;
        if (!solve_ballistic_arc(toglobal(new float3(0.0, 0.436 + 0.073, 0.077)), target, &result))
        {
            return (byte)0;
        }

        tolocald(&result);

        float yaw = atan2(result.x, result.z);
        float pitch = -asin(result.y);

        CombatTurret.target_rotation = yaw;
        CombatTurret.target_angle = pitch;

        *targetedPosition = targetLocal;
    }

    float diff1 = abs(CombatTurret.current_rotation - CombatTurret.target_rotation);
    float diff2 = abs(CombatTurret.current_angle - CombatTurret.target_angle);

    if ((diff1 < 0.1f || TAU - diff1 < 0.1f) && (diff2 < 0.01f || TAU - diff2 < 0.01f))
    {
        return (byte)1;
    }

    return (byte)0;
}

export byte targetat_simple(float2 target, float2* targetedPosition)
{
    if (target.x == 0f &&
        target.y == 0f)
    {
        return (byte)0;
    }

    if (targetedPosition.x != target.x ||
        targetedPosition.y != target.y)
    {
        *targetedPosition = target;
        target.y -= 0.2f;

        CombatTurret.target_rotation = calculate_rotation(target);

        CombatTurret.target_angle = 0.00001f; // todo: fix this
    }

    float diff = abs(CombatTurret.current_rotation - CombatTurret.target_rotation);

    if (diff < 0.1f || TAU - diff < 0.1f)
    {
        return (byte)1;
    }

    return (byte)0;
}

export byte targetat_simple(float3 target, float3* targetedPosition)
{
    if (target.x == 0f &&
        target.z == 0f)
    {
        return (byte)0;
    }

    tolocal(&target);

    if (targetedPosition.x != target.x ||
        targetedPosition.z != target.z)
    {
        *targetedPosition = target;

        float3 targetDirection3 = normalise(target);
        float targetAngle = atan2(targetDirection3.x, targetDirection3.z);
        if (targetAngle < 0f) { targetAngle += TAU; }
        if (targetAngle >= TAU) { targetAngle -= TAU; }
        CombatTurret.target_rotation = targetAngle;

        float horizontalDist = sqrt(targetDirection3.x * targetDirection3.x + targetDirection3.z * targetDirection3.z);
        float pitch = atan2(targetDirection3.y, horizontalDist) * -1;

        CombatTurret.target_angle = pitch;
    }

    float diff1 = abs(CombatTurret.current_rotation - CombatTurret.target_rotation);

    if ((diff1 < 0.1f || TAU - diff1 < 0.1f))
    {
        return (byte)1;
    }

    return (byte)0;
}

export void shootat(float2 target, float2* targetedPosition)
{
    CombatTurret.shoot = targetat(target, targetedPosition);
}

export void shootat(float3 target, float3* targetedPosition)
{
    CombatTurret.shoot = targetat(target, targetedPosition);
}

export void shootat_simple(float2 target, float2* targetedPosition)
{
    CombatTurret.shoot = targetat_simple(target, targetedPosition);
}

export void shootat_simple(float3 target, float3* targetedPosition)
{
    CombatTurret.shoot = targetat_simple(target, targetedPosition);
}
