{
    if (!try_query_attribute(attribute, data)) crash "Failed to query attribute";
}

export const int ATTRIBUTE_TURRET_MAGAZINE = 0;
export const int ATTRIBUTE_TURRET_PROJECTILE_VELOCITY = 1;
export const int ATTRIBUTE_TURRET_PROJECTILE_DAMAGE = 2;

[External("gui_create")] void gui_create(any* ptr);
[External("gui_update")] void gui_update(any* ptr);
[External("gui_destroy")] void gui_destroy(int id);

export byte colorto255(float r, float g, float b)
{
    return (byte)(
        ((byte)(r * 7) << 5) |
        ((byte)(g * 7) << 2) |
        ((byte)(b * 3))
    );
}

export byte colorto255(int r, int g, int b)
{
    return (byte)(
        ((byte)(r * 7 / 255) << 5) |
        ((byte)(g * 7 / 255) << 2) |
        ((byte)(b * 3 / 255))
    );
}

export enum UIDirection : byte
{
    Horizontal,
    Vertical,
    HorizontalReverse,
    VerticalReverse,
}

export enum UIType : byte
{
    _,
    Box,
    Label,
    Image,
}

export struct UIElement
{
    private bool _dirty;
    int _id;
    int _parent;
    int _index;
    UIDirection _direction;
    int margin;
    int padding;
    int width;
    int height;
    private UIType _type;

    export UIElement()
    {
        this._type = UIType.Box;
        this.width = 50;
        this.height = 50;
        gui_create(this);
    }

    export inline void destroy()
    {
        gui_destroy(this._id);
    }

    export inline void update()
    {
        gui_update(this);
    }
}

export struct UILabel
{
    private bool _dirty;
    int _id;
    int _parent;
    int _index;
    UIDirection _direction;
    int margin;
    int padding;
    int width;
    int height;
    private UIType _type;
    float3 color;
    char[15] text;

    export UILabel()
    {
        this._type = UIType.Label;
        this.width = 50;
        this.height = 50;
        this.text = "Hey";
        gui_create(this);
    }

    export inline void destroy()
    {
        gui_destroy(this._id);
    }

    export inline void update()
    {
        gui_update(this);
    }
}

export struct UIImage
{
    private bool _dirty;
    int _id;
    int _parent;
    int _index;
    UIDirection _direction;
    int margin;
    int padding;
    int width;
    int height;
    private UIType _type;
    i16 imgwidth;
    i16 imgheight;
    byte[510] img;

    export UIImage(i16 width, i16 height)
    {
        this._type = UIType.Image;
        this.width = 50;
        this.height = 50;
        this.imgwidth = width;
        this.imgheight = height;
        // for (int y = 0; y < height; y++)
        // {
        //     for (int x = 0; x < width; x++)
        //     {
        //         this.img[x + (y * width)] = (byte)(x + (y * width));
        //     }
        // }
        gui_create(this);
    }

    export inline void destroy()
    {
        gui_destroy(this._id);
    }

    export inline void set(int x, int y, int r, int g, int b)
    {
        this.set(x, y, colorto255(r, g, b));
    }

    export inline void fill(int r, int g, int b)
    {
        this.fill(colorto255(r, g, b));
    }

    export void set(int x, int y, byte color)
    {
        if (x < 0) x = 0;
        else if (x >= this.imgwidth) x = (int)this.imgwidth;
        if (y < 0) y = 0;
        else if (y >= this.imgheight) y = (int)this.imgheight;
        this.img[y * this.imgwidth + x] = color;
    }

    export void fill(byte color)
    {
        int l = (int)this.imgwidth * (int)this.imgheight;
        for (int i = 0; i < l; i++)
        {
            this.img[i] = color;
        }
    }

    export inline void update()
    {
        gui_update(this);
    }

    // export inline void set(int2 pos, int r, int g, int b)   { this.set(pos.x, pos.y, r, g, b); }
    // export inline void set(int2 pos, byte color)              { this.set(pos.x, pos.y, color); }

    export inline void set(float2 pos, int r, int g, int b) { this.set((int)pos.x, (int)pos.y, r, g, b); }
    export inline void set(float2 pos, byte color)            { this.set((int)pos.x, (int)pos.y, color); }
}
