using "stdlib/System";
using mm;
using utils;

export void print(float2 v)
{
    print(v.x);
    print(' ');
    print(v.y);
}

export inline void printline(float2 v)
{
    print(v);
    printline();
}

export void print(float3 v)
{
    print(v.x);
    print(' ');
    print(v.y);
    print(' ');
    print(v.z);
}

export inline void printline(float3 v)
{
    print(v);
    printline();
}

export void sleep(float sec)
{
    float at = time() + sec;
    while (time() < at) { }
}

[External("atan2")] export float atan2(float y, float x);
[External("tan")] export float tan(float v);
[External("asin")] export float asin(float v);
[External("acos")] export float acos(float v);
[External("atan")] export float atan(float v);

[External("wreceive")] export int wreceive(any* buffer, int length, float3& direction);
[External("wsend")] export void wsend(any* buffer, int length, float3& direction, float angle);

[External("receive")] export int receive(any* buffer, int length, byte port = 0);
[External("send")] export void send(any* buffer, int length, byte port = 0);

export inline void wsend(any* buffer, int length, float3 direction, float angle)
{
    wsend(buffer, length, &direction, angle);
}

export inline void wsend(any* buffer, int length, float3& direction)
{
    wsend(buffer, length, direction, 0.1f);
}

export inline void wsend(any* buffer, int length, float3 direction)
{
    wsend(buffer, length, &direction, 0.1f);
}

export inline void wsend(any* buffer, int length)
{
    wsend(buffer, length, (float3*)0, 0f);
}

[External("radar")] void _radar();

export float3 radar(float direction)
{
    Radar.direction = direction;
    //ldebug(new float3(cos(Radar.direction), 0f, sin(Radar.direction)) * 10f, Color.Cyan);
    return radar();
}

export float3 radar()
{
    Radar.response.point.x = 0f;
    Radar.response.point.y = 0f;
    Radar.response.point.z = 0f;

    _radar();

    while (Radar.response.point.x == 0f || Radar.response.point.y == 0f || Radar.response.point.z == 0f)
    {

    }

    if (isnan(Radar.response.point.x) || isnan(Radar.response.point.y) || isnan(Radar.response.point.z))
    {
        return new float3;
    }

    return Radar.response.point;
}

export void toglobal(byte3* point)
{
    float3 p;
    tofloat3(point, &p);
    toglobal(&p);
    tobyte3(&p, point);
}

export void toglobal(byte2* point)
{
    float2 p;
    tofloat2(point, &p);
    toglobal(&p);
    tobyte2(&p, point);
}

[External("toglobal")] export void toglobal(float3* point);
[External("tolocal")] export void tolocal(float3* point);

[External("toglobald")] export void toglobald(float3* direction);
[External("tolocald")] export void tolocald(float3* direction);

export float3 tolocal(float3 point)
{
    tolocal(&point);
    return point;
}

export float3 toglobal(float3 point)
{
    toglobal(&point);
    return point;
}

export float3 tolocald(float3 direction)
{
    tolocald(&direction);
    return direction;
}

export float3 toglobald(float3 direction)
{
    toglobald(&direction);
    return direction;
}

export void toglobal(float2* point)
{
    float3 _p = new float3(point.x, 0f, point.y);
    toglobal(&_p);
    *point = new float2(_p.x, _p.z);
}

export void tolocal(float2* point)
{
    float3 _p = new float3(point.x, 0f, point.y);
    tolocal(&_p);
    *point = new float2(_p.x, _p.z);
}

[External("time")] export float time();

export enum Color : byte
{
    Blue = 0b001,
    Green = 0b010,
    Cyan = 0b011,
    Red = 0b100,
    Magenta = 0b101,
    Yellow = 0b110,
    White = 0b111,
}

[External("debug")] export void debug(float3 position, Color color);
[External("ldebug")] export void ldebug(float3 localPosition, Color color);

export inline void debug(float2 position, Color color)
{
    debug(new float3(position.x, 0f, position.y), color);
}

export inline void ldebug(float2 localPosition, Color color)
{
    ldebug(new float3(localPosition.x, 0f, localPosition.y), color);
}

[External("debug_label")] export void debug_label(float3 position, temp string text);
[External("ldebug_label")] export void ldebug_label(float3 localPosition, temp string text);

export inline void debug_label(float2 position, temp string text)
{
    debug_label(new float3(position.x, 0f, position.y), temp text);
}

export inline void ldebug_label(float2 localPosition, temp string text)
{
    ldebug_label(new float3(localPosition.x, 0f, localPosition.y), temp text);
}

