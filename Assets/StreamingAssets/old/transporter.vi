using "lib/move";
using "lib/api";

[UnitCommand(1, "In")]
struct CommandIn
{
    [Context("position")] float3 position;
}

[UnitCommand(2, "Out")]
struct CommandOut
{
    [Context("position")] float3 position;
}

[UnitCommand(3, "Move to")]
struct CommandMoveTo
{
    [Context("position")] float3 position;
}

[UnitCommand(4, "Set Source")]
struct CommandSetSource
{
    [Context("position")] float3 position;
}

[UnitCommand(5, "Set Destination")]
struct CommandSetDestination
{
    [Context("position")] float3 position;
}

const int MaxCommandDataSize = 8;

void Receive()
{
    byte[MaxPacketLength] v;
    float3 direction;

    while (1)
    {
        int receivedLength = wreceive(&v, MaxPacketLength, &direction);
        if (!receivedLength) { break; }

        if (v[0] == (byte)PacketHeader.request &&
            receivedLength == sizeof(VerificationRequestPacket))
        {
            VerificationRequestPacket* packet = &v as VerificationRequestPacket*;

            if (distancesqr(packet.position, GPS.position) < DistanceThresholdSq)
            {
                printline(" M");
                VerificationResponsePacket responsePacket = new VerificationResponsePacket;
                responsePacket.header = PacketHeader.response;
                responsePacket.position = packet.position;
                debug(packet.position, Color.Cyan);
                wsend(&responsePacket as byte[]*, sizeof(VerificationResponsePacket), &direction, 0.1f);
            }
        }
    }
}

float3 currentDestination = new float3;
byte currentDirectionAtDestination = (byte)0;

float3 _loadSource = new float3;
float3 _loadDestination = new float3;
int _state = 0;

while (1)
{
    Receive();

    byte[MaxCommandDataSize] _command;

    int commandId = dequeue_command(&_command);

    if (commandId == 1)
    {
        CommandIn* command = &_command as CommandIn*;
        currentDirectionAtDestination = (byte)2;
        currentDestination = command.position;
    }
    else if (commandId == 2)
    {
        CommandOut* command = &_command as CommandOut*;
        currentDirectionAtDestination = (byte)1;
        currentDestination = command.position;
    }
    else if (commandId == 3)
    {
        CommandMoveTo* command = &_command as CommandMoveTo*;
        currentDirectionAtDestination = (byte)0;
        currentDestination = command.position;
    }
    else if (commandId == 4)
    {
        CommandSetSource* command = &_command as CommandSetSource*;
        _loadSource = command.position;
        currentDestination = new float3;
    }
    else if (commandId == 5)
    {
        CommandSetDestination* command = &_command as CommandSetDestination*;
        _loadDestination = command.position;
        currentDestination = new float3;
    }

    if (currentDestination.x != 0f &&
        currentDestination.z != 0f)
    {
        float d = distancesqr(GPS.position, currentDestination);
        if (d < 2f * 2f)
        {
            stop_moving();
            Transporter.load_direction = currentDirectionAtDestination;
        }
        else
        {
            move_to(currentDestination.x, currentDestination.z);
        }
    }
    else if (_loadSource.x != 0f &&
             _loadSource.z != 0f &&
             _loadDestination.x != 0f &&
             _loadDestination.z != 0f)
    {
        if (_state == 0)
        {
            float d = distancesqr(GPS.position, _loadSource);
            if (d < 2f * 2f)
            {
                _state = 1;
            }
            else
            {
                move_to(_loadSource.x, _loadSource.z);
            }
        }
        else if (_state == 1)
        {
            stop_moving();
            Transporter.load_direction = (byte)2;
            if (Transporter.current_load > 10)
            {
                _state = 2;
            }
        }
        else if (_state == 2)
        {
            float d = distancesqr(GPS.position, _loadDestination);
            if (d < 2f * 2f)
            {
                _state = 3;
            }
            else
            {
                move_to(_loadDestination.x, _loadDestination.z);
            }
        }
        else if (_state == 3)
        {
            stop_moving();
            Transporter.load_direction = (byte)1;
            if (Transporter.current_load <= 0)
            {
                _state = 0;
            }
        }
    }
}
