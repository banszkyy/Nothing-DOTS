using "lib/api";
using "lib/protocol";

[UnitCommand(1, "Attack at")]
struct CommandAttackAt
{
    [Context("position3")] float3 position;
}

const int MaxCommandDataSize = 8;

void receive()
{
    byte[MaxPacketLength] v;
    float3 direction;
    byte port = 0;

    while (1)
    {
        int receivedLength = wreceive(&v, MaxPacketLength, &direction);
        if (!receivedLength) { break; }

        if (v[0] == (byte)PacketHeader.request &&
            receivedLength == sizeof(VerificationRequestPacket))
        {
            VerificationRequestPacket* packet = &v as VerificationRequestPacket*;

            VerificationResponsePacket responsePacket = new VerificationResponsePacket;
            responsePacket.header = PacketHeader.response;

            if (distancesqr(packet.position, GPS.position) < DistanceThresholdLargeSq)
            {
                responsePacket.position = packet.position;
                debug(packet.position, Color.Cyan);
                wsend(&responsePacket as byte[]*, sizeof(VerificationResponsePacket), &direction, 0.1f);
            }
            else
            {
                for (int i = 0; i < (&allies).length(); i++)
                {
                    float distanceSqr = distancesqr((&allies).raw()[i].position, packet.position);
                    if (distanceSqr < DistanceThresholdSq)
                    {
                        IndirectVerificationResponsePacket indirectResponsePacket = new IndirectVerificationResponsePacket;
                        indirectResponsePacket.header = PacketHeader.indirect_response;
                        indirectResponsePacket.position = (&allies).raw()[i].position;
                        indirectResponsePacket.expires = (&allies).raw()[i].expires;
                        wsend(&indirectResponsePacket as byte[]*, sizeof(IndirectVerificationResponsePacket), &direction, 0.1f);
                        return;
                    }
                }
            }
        }
        else if (v[0] == (byte)PacketHeader.response &&
                 receivedLength == sizeof(VerificationResponsePacket))
        {
            VerificationResponsePacket* packet = &v as VerificationResponsePacket*;

            Unit unit;
            unit.position = packet.position;
            unit.recorded = time();
            unit.expires = time() + 10f;
            unit.verification_sent_at = time();
            remove_unit_at(&enemies, unit.position);
            update_unit(&allies, unit);
            int bi = unit_index_at(&buildings, unit.position);
            if (bi != -1) buildings[bi].placeholder = false;
        }
        else if (v[0] == (byte)PacketHeader.enemy &&
                 receivedLength == sizeof(EnemyNotificationPacket))
        {
            EnemyNotificationPacket* packet = &v as EnemyNotificationPacket*;

            print("E\n");

            Unit unit;
            unit.position = packet.position;
            unit.recorded = 0f;
            unit.expires = time() + 5f;
            unit.verification_sent_at = time();
            int j = update_unit(&enemies, unit);

            for (int i = 0; i < (&allies).length(); i++)
            {
                if (i != j)
                {
                    direction = (&allies).raw()[i].position;
                    tolocal(&direction);
                    normalise(&direction);

                    print("NTFY\n");

                    wsend(&packet as byte[]*, sizeof(EnemyNotificationPacket), &direction);
                }
            }
        }
        else if (v[0] == (byte)PacketHeader.indirect_response &&
                 receivedLength == sizeof(IndirectVerificationResponsePacket))
        {
            IndirectVerificationResponsePacket* packet = &v as IndirectVerificationResponsePacket*;

            Unit unit;
            unit.position = packet.position;
            unit.recorded = time();
            unit.expires = packet.expires;
            unit.verification_sent_at = time();
            remove_unit_at(&enemies, unit.position);
            update_unit(&allies, unit);
            int bi = unit_index_at(&buildings, unit.position);
            if (bi != -1) buildings[bi].placeholder = false;
        }
    }

    while (1)
    {
        int receivedLength = receive(&v, MaxPacketLength, port);
        if (!receivedLength) { break; }

        if (v[0] == (byte)PacketHeader.request &&
            receivedLength == sizeof(VerificationRequestPacket))
        {
            VerificationRequestPacket* packet = &v as VerificationRequestPacket*;

            VerificationResponsePacket responsePacket = new VerificationResponsePacket;
            responsePacket.header = PacketHeader.response;

            if (!packet.position.x && !packet.position.z)
            {
                responsePacket.position = GPS.position;
                send(&responsePacket as byte[]*, sizeof(VerificationResponsePacket), port);
            }
            else if (distancesqr(packet.position, GPS.position) < DistanceThresholdLargeSq)
            {
                responsePacket.position = packet.position;
                debug(packet.position, Color.Cyan);
                send(&responsePacket as byte[]*, sizeof(VerificationResponsePacket), port);
            }
            else
            {
                for (int i = 0; i < (&allies).length(); i++)
                {
                    float distanceSqr = distancesqr((&allies).raw()[i].position, packet.position);
                    if (distanceSqr < DistanceThresholdSq)
                    {
                        IndirectVerificationResponsePacket indirectResponsePacket = new IndirectVerificationResponsePacket;
                        indirectResponsePacket.header = PacketHeader.indirect_response;
                        indirectResponsePacket.position = (&allies).raw()[i].position;
                        indirectResponsePacket.expires = (&allies).raw()[i].expires;
                        send(&indirectResponsePacket as byte[]*, sizeof(IndirectVerificationResponsePacket), port);
                        return;
                    }
                }
            }
        }
        else if (v[0] == (byte)PacketHeader.response &&
                 receivedLength == sizeof(VerificationResponsePacket))
        {
            VerificationResponsePacket* packet = &v as VerificationResponsePacket*;

            Unit unit;
            unit.position = packet.position;
            unit.recorded = time();
            unit.expires = time() + 10f;
            unit.verification_sent_at = time();
            remove_unit_at(&enemies, unit.position);
            update_unit(&allies, unit);
            int bi = unit_index_at(&buildings, packet.position);
            if (bi != -1) buildings[bi].placeholder = false;
        }
        else if (v[0] == (byte)PacketHeader.enemy &&
                 receivedLength == sizeof(EnemyNotificationPacket))
        {
            EnemyNotificationPacket* packet = &v as EnemyNotificationPacket*;

            print("E\n");

            Unit unit;
            unit.position = packet.position;
            unit.recorded = 0f;
            unit.expires = time() + 5f;
            unit.verification_sent_at = time();
            int j = update_unit(&enemies, unit);

            for (int i = 0; i < (&allies).length(); i++)
            {
                if (i != j)
                {
                    var direction = (&allies).raw()[i].position;
                    tolocal(&direction);
                    normalise(&direction);

                    print("NTFY\n");

                    wsend(&packet as byte[]*, sizeof(EnemyNotificationPacket), &direction);
                }
            }
        }
        else if (v[0] == (byte)PacketHeader.indirect_response &&
                 receivedLength == sizeof(IndirectVerificationResponsePacket))
        {
            IndirectVerificationResponsePacket* packet = &v as IndirectVerificationResponsePacket*;

            Unit unit;
            unit.position = packet.position;
            unit.recorded = time();
            unit.expires = packet.expires;
            unit.verification_sent_at = time();
            remove_unit_at(&enemies, unit.position);
            update_unit(&allies, unit);
            int bi = unit_index_at(&buildings, unit.position);
            if (bi != -1) buildings[bi].placeholder = false;
        }
    }
}

List<Unit> enemies = new List<Unit>(4);
List<Unit> allies = new List<Unit>(4);

UIElement _container = new UIElement();
_container._direction = UIDirection.VerticalReverse;
_container.update();

UIImage _minimap = new UIImage((i16)22, (i16)22);
_minimap._parent = _container._id;
_minimap.width = 100;
_minimap.height = 100;
_minimap.margin = 8;
_minimap.update();
float lastPortScan = 0f;

const float MinimapScale = 1f;

print("Started ...\n");

struct Building
{
    byte type;
    bool placeholder;
    float3 position;
}

List<Building> buildings = new List<Building>(4);

{
    u8[] s0 = "Facility";
    u8[] s1 = "facility.vi";
    float3 p = GPS.position + new float3(10f, 0f, 0f);
    build_at(p, &s0, &s1);
    var b = new Building;
    b.type = 1;
    b.placeholder = true;
    b.position = p;
    buildings.add(b);
}

while (1)
{
    receive();

    (&_minimap).fill((byte)0);
    (&_minimap).set(new float2(11f, 11f), (byte)0b_111_111_11);

    for (int i = (&enemies).length() - 1; i >= 0; i--)
    {
        Unit* enemy = &(&enemies).raw()[i];
        if (time() >= enemy.expires)
        {
            (&enemies).remove(i);
        }
        else
        {
            try_send_verification_request(enemy);
            float3 p = enemy.position;
            tolocal(&p);
            if (time() >= enemy.recorded + 4f)
            {
                ldebug(p, Color.Red);
                (&_minimap).set((new float2(p.x, p.z) * (0.5f * MinimapScale) + new float2(11f, 11f)), (byte)((int)(0b_111 * max(0f, enemy.expires - time()) / 10f) << 5));
                printf("%f\n", [p.x]);
            }
        }
    }

    for (int i = (&allies).length() - 1; i >= 0; i--)
    {
        Unit* ally = &(&allies).raw()[i];
        if (time() >= ally.expires)
        {
            try_send_verification_request(ally);
            (&allies).remove(i);
        }
        else
        {
            float3 p = ally.position;
            debug(p, Color.Green);
            tolocal(&p);
            (&_minimap).set((new float2(p.x, p.z) * (0.5f * MinimapScale) + new float2(11f, 11f)), (byte)((int)(0b_111 * max(0f, ally.expires - time()) / 10f) << 2));
        }
    }

    byte[MaxCommandDataSize] _command;

    int commandId = dequeue_command(&_command);

    if (commandId == 1)
    {
        CommandAttackAt* command = &_command as CommandAttackAt*;
        debug(command.position, Color.Red);

        EnemyNotificationPacket notificationPacket;
        notificationPacket.header = PacketHeader.enemy;
        notificationPacket.position = command.position;
        wsend(&notificationPacket as byte[]*, sizeof(EnemyNotificationPacket));
    }

    for (int i = buildings.length() - 1; i >= 0; i--)
    {
        Building b = buildings[i];
        if (b.placeholder)
        {
            BuildableNotificationPacket p;
            p.header = PacketHeader.buildable;
            p.position = b.position;
            wsend(&p as byte[]*, sizeof(BuildableNotificationPacket));
        }
    }

    if (time() - lastPortScan > 5f)
    {
        lastPortScan = time();
        VerificationRequestPacket p;
        p.header = PacketHeader.request;
        p.position = new float3;
        send(&p as byte[]*, sizeof(VerificationRequestPacket), (byte)0);
    }

    (&_minimap).update();
}
