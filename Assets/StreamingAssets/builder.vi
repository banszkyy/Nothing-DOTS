using "lib/turret";
using "lib/move";
using "lib/api";
using "lib/protocol";

[UnitCommand(1, "󰍒")]
struct CommandMoveTo
{
    [Context("position3")] float3 position;
}

[UnitCommand(2, "")]
struct CommandBuildAt
{
    [Context("position3")] float3 position;
}

const int MaxCommandDataSize = 8;

void Receive()
{
    byte[MaxPacketLength] v;
    float3 direction;

    while (1)
    {
        int receivedLength = wreceive(&v, MaxPacketLength, &direction);
        if (!receivedLength) { break; }

        if (v[0] == (byte)PacketHeader.request &&
            receivedLength == sizeof(VerificationRequestPacket))
        {
            VerificationRequestPacket* packet = &v as VerificationRequestPacket*;

            VerificationResponsePacket responsePacket = new VerificationResponsePacket;
            responsePacket.header = PacketHeader.response;
            responsePacket.position = packet.position;

            if (distancesqr(packet.position, GPS.position) < DistanceThresholdSq)
            {
                debug(packet.position, Color.Cyan);

                wsend(&responsePacket as byte[]*, sizeof(VerificationResponsePacket), &direction, 0.1f);
            }
        }
        else if (v[0] == (byte)PacketHeader.buildable &&
            receivedLength == sizeof(BuildableNotificationPacket))
        {
            BuildableNotificationPacket* packet = &v as BuildableNotificationPacket*;
            int ex = -1;
            for (int i = buildables.length() - 1; i >= 0; i--)
            {
                if (distancesqr(buildables[i].position, packet.position) < 3)
                {
                    ex = i;
                    break;
                }
            }
            if (ex == -1 && buildables.length() < 4)
            {
                buildables.add(new Buildable(packet.position));
            }
        }
        else
        {
            printf("unknown packet %d\n", [(int)v[0]]);
        }
    }
}

struct Buildable
{
    float3 position;
    float doneAt;

    init(float3 p) {
        this.position = p;
    }
}

float3 currentDestination = new float3;
float3 currentBuildAt = new float3;
float3 targetedPosition = new float3;
bool isBuilding = false;
List<Buildable> buildables = new List<Buildable>(4);

print("ready\n");

while (1)
{
    Receive();

    byte[MaxCommandDataSize] _command;

    int currentBuildIndex = -1;

    for (int i = 0; i < buildables.length(); i++)
    {
        if (!buildables[i].doneAt)
        {
            currentBuildAt = buildables[0].position;
            currentBuildIndex = i;
        }
    }

    int commandId = dequeue_command(&_command);

    if (commandId == 1)
    {
        CommandMoveTo* command = &_command as CommandMoveTo*;
        currentBuildAt = new float3;
        currentDestination = command.position;
        currentBuildIndex = -1;
        printf("COMMAND moving to %f %f\n", [command.position.x, command.position.z]);
    }
    else if (commandId == 2)
    {
        CommandMoveTo* command = &_command as CommandMoveTo*;
        currentBuildAt = command.position;
        currentDestination = new float3;
        currentBuildIndex = -1;
        printf("COMMAND building at %f %f\n", [command.position.x, command.position.z]);
    }

    if (currentDestination.x != 0f ||
        currentDestination.z != 0f)
    {
        if (!move_to(currentDestination.x, currentDestination.z))
        {
            currentDestination = new float3;
            print("ready\n");
        }
    }

    if (currentBuildAt.x != 0f ||
        currentBuildAt.z != 0f)
    {
        float d = distancesqr(GPS.position, currentBuildAt);
        if (d < 4f * 4f)
        {
            stop_moving();

            if (CombatTurret.shoot == 2)
            {
                isBuilding = true;
            }
            else if (isBuilding)
            {
                if (currentBuildIndex != -1)
                {
                    printf("building %d done\n", [currentBuildIndex]);
                    buildables[currentBuildIndex].doneAt = time();
                }

                currentBuildAt = new float3;
                print("ready\n");
            }

            shootat_simple(currentBuildAt, &targetedPosition);
            debug(currentBuildAt, Color.White);
        }
        else
        {
            move_to(currentBuildAt.x, currentBuildAt.z);
        }
    }
    else
    {
        isBuilding = false;
        CombatTurret.target_rotation = 0f;
        CombatTurret.target_angle = 0f;
    }
}
