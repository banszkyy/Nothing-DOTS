using "lib/api";
using "netstack";

struct Unit {
    float3 lastPos;
    float lastAuthAt;
    float lastHeartbeatAt;
    float lastRadarAt;
    float lastNotifiedAt;
    i32 authNum;
}

const float DST_THRESHOLD_SQR = 2f * 2f;

i32 id = (time() as i32) ^ (GPS.position.x as i32) ^ (GPS.position.z as i32);
i32 address = 0;
float addressRequestedAt = 0f;
float3 serverLastDirection = new float3;
List<Unit> allies = new List<Unit>(4);
List<Unit> enemies = new List<Unit>(4);
i32 unitIdCounter = 1;
float lastAdvertisement = 0f;

int unitAt(List<Unit>& units, float3 position, float* distanceSqr) {
    float d0 = 9999f;
    int res = -1;
    for (int i = 0; i < units.length(); i++) {
        float d1 = distancesqr(units[i].lastPos, position);
        if (d1 < d0) {
            d0 = d1;
            res = i;
        }
    }
    *distanceSqr = d0;
    return res;
}

int unitOf(List<Unit>& units, i32 authNum) {
    for (int i = 0; i < units.length(); i++) {
        if (units[i].authNum == authNum) {
            return i;
        }
    }
    return -1;
}

void authAt(Unit& unit) {
    if (!address) return;
    byte[] req = pack {
        new RadioHeader {
            header = RadioHeaderValues.Uplink,
        },
        new AuthChallenge {
            header = Header.AuthChallenge,
            position = unit.lastPos,
            authNum = unit.authNum,
            src = address,
        }
    };
    wsend(&req, serverLastDirection, 8);
    unit.lastAuthAt = time();
    debug(unit.lastPos, Color.Magenta);
    printf("Auth at %f %f %f with %d\n", unit.lastPos.x, unit.lastPos.y, unit.lastPos.z, unit.authNum);
}

printf("I'm %d\n", [id]);

while (true) {
    LEDs.custom_led = true;

    while (true) {
        byte[30] buffer;
        float3 direction;
        int l = wreceive(&buffer, &direction, (byte*)0);
        if (!l) break;

        int o = 0;

        if (buffer[o] == (byte)RadioHeaderValues.Downlink) {
            RadioHeader* header = &buffer[o] as RadioHeader*;
            o += sizeof(RadioHeader);

            if (buffer[o] == (byte)Header.DhcpResponseOk) {
                DhcpResponseOk* req = &buffer[o] as DhcpResponseOk*;
                if (req.id == id) {
                    serverLastDirection = direction;
                    address = req.address;
                    printf("Received address %d\n", [address]);
                }
            } else if (buffer[o] == (byte)Header.Radar) {
                Radar* req = &buffer[o] as Radar*;
                if (req.emission && distancesqr(req.position, GPS.position) >= 4f * 4f) {
                    float d;
                    int u = unitAt(allies, req.position, &d);
                    if (u == -1 || d > DST_THRESHOLD_SQR) {
                        u = unitAt(enemies, req.position, &d);
                        if (u == -1 || d > DST_THRESHOLD_SQR) {
                            printf("Suspicion at %f %f %f\n", [req.position.x, req.position.y, req.position.z]);
                            debug(req.position, Color.Yellow);
                            enemies.add(new Unit {
                                lastPos = req.position,
                                authNum = unitIdCounter,
                                lastAuthAt = 0f,
                                lastHeartbeatAt = time(),
                                lastRadarAt = time(),
                            });
                            unitIdCounter++;
                        }
                    }
                }
            } else if (buffer[o] == (byte)Header.AuthChallenge) {
                AuthChallenge* req = &buffer[o] as AuthChallenge*;
                if (distancesqr(req.position, GPS.position) < 4f * 4f) {
                    byte[] res = pack {
                    new RadioHeader {
                        header = RadioHeaderValues.Uplink,
                    },
                    new AuthResponse {
                        header = Header.AuthResponse,
                            authNum = req.authNum,
                        dst = req.src,
                    },
                };
                    wsend(&res);
                }
            } else if (buffer[o] == (byte)Header.AuthResponse) {
                AuthResponse* req = &buffer[o] as AuthResponse*;
                if (req.dst == address) {
                    int u = unitOf(enemies, req.authNum);
                    if (u != -1) {
                        Unit w = enemies[u];
                        w.lastHeartbeatAt = time();
                        enemies.swapback(u);
                        allies.add(w);
                    } else {
                        u = unitOf(allies, req.authNum);
                        if (u != -1) {
                            allies[u].lastHeartbeatAt = time();
                        } else {
                            printf("Unexpected auth response num %d\n", req.authNum);
                        }
                    }
                }
            }
        }
    }

    if (!address && time() - addressRequestedAt > 5f) {
        printf("Requesting address\n");

        byte[] req = pack {
            new RadioHeader {
                header = RadioHeaderValues.Uplink,
            },
            new DhcpRequest {
                header = Header.DhcpRequest,
                id = id,
            },
        };
        wsend(&req);
        addressRequestedAt = time();
    } else {
        if (time() - lastAdvertisement > 5f) {
            byte[] req = pack {
                new RadioHeader {
                    header = RadioHeaderValues.Uplink,
                },
                new AuthenticatorAdvertisement {
                    header = Header.AuthenticatorAdvertisement,
                    src = address,
                }
            };
            wsend(&req, serverLastDirection, 8);

            byte[] req = pack {
                new RadioHeader {
                    header = RadioHeaderValues.Uplink,
                },
                new AllyAt {
                    header = Header.AllyAt,
                    position = GPS.position,
                }
            };
            wsend(&req, serverLastDirection, 8);

            lastAdvertisement = time();
        }

        for (int i = 0; i < allies.length(); i++)
        {
            Unit& u = allies[i];

            debug(u.lastPos, Color.Green);

            if (u.lastAuthAt != 0f) {
                if (time() - u.lastNotifiedAt > 4f) {
                    u8[] req = pack {
                        new RadioHeader {
                            header = RadioHeaderValues.Uplink,
                        },
                        new AllyAt {
                            header = Header.AllyAt,
                            position = u.lastPos,
                        }
                    };
                    wsend(&req, req.Length, serverLastDirection, 8);
                    u.lastNotifiedAt = time();
                }
            }

            if (time() - u.lastAuthAt > 5f) {
                authAt(u);
            }
        }

        for (int i = 0; i < enemies.length(); i++)
        {
            Unit& u = enemies[i];

            if (u.lastAuthAt != 0f && time() - u.lastHeartbeatAt > 5f) {
                debug(u.lastPos, Color.Red);
                if (time() - u.lastNotifiedAt > 2f) {
                    u8[] req = pack {
                        new RadioHeader {
                            header = RadioHeaderValues.Uplink,
                        },
                        new EnemyAt {
                            header = Header.EnemyAt,
                            position = u.lastPos,
                        }
                    };
                    wsend(&req, req.Length, serverLastDirection, 8);
                    u.lastNotifiedAt = time();

                    if (time() - u.lastRadarAt > 6f) {
                        enemies.swapback(i);
                        i--;
                        goto skip;
                    }
                }
            }

            if (time() - u.lastAuthAt > 1f) {
                authAt(u);
            }

            skip:
        }
    }
}
