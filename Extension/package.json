{
    "name": "nothingame",
    "description": "Extension for my RTS game",
    "author": "Bánszky",
    "version": "0.0.1",
    "displayName": "NothinGame",
    "private": true,
    "preview": true,
    "engines": {
        "vscode": "^1.88.0"
    },
    "categories": [
        "Other"
    ],
    "pricing": "Free",
    "publisher": "banszky",
    "markdown": "github",
    "icon": "icons/extension.png",
    "homepage": "https://github.com/banszkyy/Nothing-DOTS",
    "galleryBanner": {
        "color": "#2d1d37",
        "theme": "dark"
    },
    "repository": {
        "url": "https://github.com/banszkyy/Nothing-DOTS",
        "type": "github"
    },
    "main": "./out/extension",
    "activationEvents": [
        "onUri"
    ],
    "contributes": {
        "debuggers": [
            {
                "type": "nothingame",
                "label": "Debug Unit"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "gameUnits",
                    "name": "Game Units",
                    "type": "tree"
                }
            ],
            "debug": [
                {
                    "id": "unitLog",
                    "name": "Unit Logs",
                    "type": "tree",
                    "when": "inDebugMode && debugType == 'nothingame'"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "nothingame.units.refresh",
                    "when": "view == gameUnits",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "nothingame.debug.attach",
                    "when": "viewItem == nothingameEntity"
                }
            ],
            "debug/toolBar": [
                {
                    "command": "nothingame.profiling.start",
                    "when": "isWorkspaceTrusted && debugType == 'nothingame' && !nothingame.isProfiling",
                    "group": "navigation"
                },
                {
                    "command": "nothingame.profiling.stop",
                    "when": "isWorkspaceTrusted && debugType == 'nothingame' && nothingame.isProfiling",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Nothingame",
            "type": "object",
            "properties": {}
        },
        "commands": [
            {
                "command": "nothingame.server.restart",
                "category": "Nothingame",
                "title": "Restart Language Server"
            },
            {
                "command": "nothingame.units.refresh",
                "category": "Nothingame",
                "icon": "$(refresh)",
                "title": "Refresh units"
            },
            {
                "command": "nothingame.authenticate",
                "category": "Nothingame",
                "icon": "$(key)",
                "title": "Authenticate with token"
            },
            {
                "command": "nothingame.debug.attach",
                "category": "Nothingame",
                "title": "Debug unit"
            },
            {
                "command": "nothingame.profiling.start",
                "category": "Nothingame",
                "title": "Start profiling active debug session",
                "when": "isWorkspaceTrusted && inDebugMode && debugType == 'nothingame'",
                "icon": "$(flame)",
                "shortTitle": "Start profiling"
            },
            {
                "command": "nothingame.profiling.stop",
                "category": "Nothingame",
                "title": "Stop profiling active debug session",
                "when": "isWorkspaceTrusted && inDebugMode && debugType == 'nothingame'",
                "icon": "$(flame)",
                "shortTitle": "Stop profiling"
            }
        ]
    },
    "scripts": {
        "compile": "./clean && tsc --project ./",
        "package": "vsce package --out NothingameExtension.vsix",
        "list": "vsce ls"
    },
    "devDependencies": {
        "@types/adm-zip": "latest",
        "@types/node": "latest",
        "@types/vscode": "^1.88.0",
        "@vscode/vsce": "latest",
        "typescript": "latest",
        "vsce": "latest"
    },
    "dependencies": {
        "adm-zip": "latest",
        "vscode-languageclient": "^9.0.1"
    }
}
